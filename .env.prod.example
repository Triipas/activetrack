# Copiar como .env.prod y reemplazar todos los valores antes de desplegar.
# Este archivo de ejemplo se sube al repositorio; .env.prod NO (está en .gitignore).

# Clave de la base de datos PostgreSQL
DB_PASSWORD=cambiar-clave-base-de-datos

# Usuario y clave de RabbitMQ
RABBIT_USER=activetrack
RABBIT_PASSWORD=cambiar-clave-rabbitmq

# Clave para firmar los JWT (mínimo 32 caracteres, aleatoria)
JWT_SECRET=cambiar-por-una-clave-aleatoria-de-al-menos-32-caracteres

# Claves de los usuarios de la aplicación (reemplazan a las de demostración al desplegar)
CLAVE_ORGANIZADOR=cambiar-clave-organizador
CLAVE_JUEZ=cambiar-clave-juez

# Puerto público del frontend
PUERTO_HTTP=80
