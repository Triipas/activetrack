@startuml
!pragma layout smetana
!include style.iuml
skinparam node {
  BorderColor #1F4E79
  BackgroundColor #EAF2FB
}
node "Dispositivo del usuario" as dev {
  artifact "Navegador / PWA" as br
}
node "Lector RFID en pista" as hw
rectangle "AWS us-east-1 (VPC por defecto)" #F5F9FD {
  node "Elastic IP y Security Group (80 público, 22 solo administrador)" as sg
  node "EC2 t3.medium - Ubuntu 24.04 - Docker Compose" as ec2 {
    artifact "frontend (Nginx)" as fe
    artifact "inscripciones-service" as s1
    artifact "cronometraje-service" as s2
    artifact "resultados-service" as s3
    artifact "notificaciones-service" as s4
    artifact "RabbitMQ" as mq
    artifact "PostgreSQL (volumen persistente)" as pg
    artifact "Redis" as rd
  }
}
br --> sg : HTTP / WS
hw --> sg : HTTP (REST)
sg --> fe : :80
fe --> s1
fe --> s2
fe --> s3
fe --> s4
s1 --> mq
s2 --> mq
mq --> s3
mq --> s4
s3 --> pg
s3 --> rd
@enduml
